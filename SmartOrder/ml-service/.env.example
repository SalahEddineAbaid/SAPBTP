# ============================================================
# SmartOrder ML — Environment Variables Template
# Copy to .env and adjust values
# ============================================================

# --- Environment ---
ML_ENV=development
DEBUG=true

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# --- PostgreSQL (Development) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartorder
POSTGRES_USER=smartorder
POSTGRES_PASSWORD=changeme
POSTGRES_SCHEMA=smartorder

# --- SAP HANA (Production) ---
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=SMARTORDER
HANA_ENCRYPT=true

# --- OData CAP Backend (Development) ---
ODATA_BASE_URL=http://localhost:4004/odata/v4
ODATA_AUTH_TOKEN=

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=smartorder-ml
MLFLOW_REGISTRY_URI=./mlruns

# --- Model Paths ---
MODEL_DIR=./models
DATA_DIR=./data

# --- SAP S/4HANA API (Sandbox) ---
SAP_S4_URL=https://my422081.s4hana.cloud.sap
SAP_COMM_USER=
SAP_COMM_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
