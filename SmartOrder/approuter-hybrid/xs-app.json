{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "websockets": {
    "enabled": true
  },
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/login"
  },
  "routes": [
    {
      "source": "^/api/health$",
      "target": "/api/health",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/me$",
      "target": "/api/me",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/oauth/callback(.*)$",
      "target": "/api/oauth/callback$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/login(.*)$",
      "target": "/api/login$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/socket.io/(.*)$",
      "target": "/socket.io/$1",
      "destination": "srv-api",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)\\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|ico|json|map)$",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)",
      "target": "/index.html",
      "localDir": "resources",
      "authenticationType": "none"
    }
  ]
}