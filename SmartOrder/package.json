{
  "name": "SmartOrder",
  "version": "1.0.0",
  "description": "SmartOrder — Application intelligente de gestion des commandes SAP BTP (YAAS)",
  "private": true,
  "dependencies": {
    "@cap-js/postgres": "^1",
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap-cloud-sdk/resilience": "^3",
    "@sap/audit-logging": "^5",
    "@sap/cds": "^8.9.10",
    "@sap/xsenv": "^5",
    "@sap/xssec": "^4",
    "axios": "^1.6.7",
    "compression": "^1.7.4",
    "csv-stringify": "^6.4.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "hdb": "^0.19.10",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "pg": "^8.14.1",
    "socket.io": "^4.7.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@radix-ui/react-switch": "^1.3.1",
    "@sap/cds-dk": "^8.9.10",
    "concurrently": "^8.2.2",
    "eslint": "^10.0.0",
    "framer-motion": "^12.40.0",
    "jest": "^29.7.0",
    "react-countup": "^6.5.3",
    "supertest": "^6.3.3"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "bas": "PORT=5000 SMARTORDER_CSV_FALLBACK=true SMARTORDER_READ_SOURCE=csv NODE_OPTIONS=\"--max-http-header-size=262144\" cds watch --profile hybrid",
    "hybrid": "SMARTORDER_CSV_FALLBACK=true SMARTORDER_READ_SOURCE=auto SMARTORDER_READ_TIMEOUT_MS=30000 NODE_OPTIONS=\"--max-http-header-size=262144\" cds watch --profile hybrid",
    "hybrid:csv": "SMARTORDER_CSV_FALLBACK=true SMARTORDER_READ_SOURCE=csv SMARTORDER_READ_TIMEOUT_MS=30000 NODE_OPTIONS=\"--max-http-header-size=262144\" cds watch --profile hybrid",
    "hybrid:serve": "SMARTORDER_CSV_FALLBACK=true SMARTORDER_READ_SOURCE=csv SMARTORDER_READ_TIMEOUT_MS=30000 NODE_OPTIONS=\"--max-http-header-size=262144\" cds serve all --profile hybrid",
    "hybrid:auto": "SMARTORDER_CSV_FALLBACK=true SMARTORDER_READ_SOURCE=auto SMARTORDER_READ_TIMEOUT_MS=30000 NODE_OPTIONS=\"--max-http-header-size=262144\" cds watch --profile hybrid",
    "hybrid:neon": "SMARTORDER_CSV_FALLBACK=false SMARTORDER_READ_SOURCE=postgres SMARTORDER_READ_TIMEOUT_MS=30000 NODE_OPTIONS=\"--max-http-header-size=262144\" cds watch --profile hybrid",
    "hybrid:xsuaa": "SMARTORDER_CSV_FALLBACK=true SMARTORDER_READ_SOURCE=csv NODE_OPTIONS=\"--max-http-header-size=262144\" cds bind --profile hybrid --exec -- cds watch --profile hybrid-xsuaa",
    "hybrid:approuter": "cds bind --profile hybrid --exec -- npm --prefix approuter-hybrid start",
    "hybrid:approuter-only": "cd approuter-hybrid && npm start",
    "hybrid:all": "concurrently -k -n cds,ui,router -c blue,green,magenta \"npm run hybrid\" \"npm --prefix app/orders-ui run start:xsuaa\" \"npm run hybrid:approuter\"",
    "hybrid:production": "concurrently -k -n cds,router -c blue,magenta \"npm run hybrid\" \"npm run hybrid:approuter\"",
    "neon:bind:direct": "bash scripts/neon-direct-cups.sh",
    "neon:check": "NODE_ENV=production cds bind --profile hybrid --exec -- node scripts/neon-check.js",
    "neon:init": "NODE_ENV=production cds bind --profile hybrid --exec -- node scripts/neon-init-schema.js",
    "neon:reset": "NODE_ENV=production cds bind --profile hybrid --exec -- node scripts/neon-init-schema.js --reset",
    "neon:deploy": "NODE_ENV=production cds bind --profile hybrid --exec -- cds deploy --to postgres --profile hybrid",
    "build": "cds build",
    "deploy:db": "cds deploy --to postgres",
    "test": "jest --coverage --forceExit",
    "lint": "eslint srv/"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "[hybrid]": {
          "kind": "postgres",
          "credentials": {},
          "pool": {
            "min": 0,
            "max": 2,
            "acquireTimeoutMillis": 10000,
            "destroyTimeoutMillis": 5000,
            "idleTimeoutMillis": 15000
          },
          "client": {
            "connectionTimeoutMillis": 15000,
            "query_timeout": 45000,
            "statement_timeout": 60000,
            "keepAlive": true,
            "keepAliveInitialDelayMillis": 10000,
            "enableChannelBinding": true,
            "ssl": {
              "rejectUnauthorized": false
            }
          }
        }
      },
      "auth": {
        "kind": "xsuaa",
        "[hybrid]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "ADMIN",
                "admin.users",
                "admin.sync",
                "dashboard.read",
                "authenticated-user"
              ],
              "attributes": {
                "username": "admin",
                "email": "admin@yaas.ma"
              }
            },
            "manager": {
              "password": "manager",
              "roles": [
                "MANAGER",
                "analytics.read",
                "dashboard.read",
                "authenticated-user"
              ],
              "attributes": {
                "username": "m.benali",
