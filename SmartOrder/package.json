              "roles": [
                "USER",
                "authenticated-user"
              ],
              "attributes": {
                "username": "y.alami",
                "email": "y.alami@yaas.ma"
              }
            },
            "k.nadi@yaas.ma": {
              "password": "",
              "roles": [
                "ADMIN",
                "MANAGER",
                "USER",
                "admin.users",
                "admin.sync",
                "dashboard.read",
                "analytics.read",
                "authenticated-user"
              ],
              "attributes": {
                "username": "k.nadi",
