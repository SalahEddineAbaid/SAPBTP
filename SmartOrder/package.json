              }
            }
          }
        }
      },
      "SAP_ERP": {
        "kind": "odata-v4",
        "credentials": {
          "destination": "SAP_ERP"
        }
      },
      "destinations": {
        "kind": "destinations"
      },
      "html5-repo": {
        "kind": "html5-repo-runtime"
      },
      "logging": {
        "kind": "application-logging"
      }
    },
    "server": "./server.js",
    "features": {
      "fetch_csrf": true,
      "serve_on_root": true
    },
    "build": {
      "target": "gen"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
